{
  "version": "0.7.0-beta.1",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../education/NOTICE.md": "licenses/education/NOTICE.md",
      "../../education/licenses/": "licenses/education/",
      "templates": "templates",
      "binaries/video-worker/": "video-worker/",
      "binaries/onnxruntime/": "./",
      "binaries/windows-runtime/python/": "python/",
      "binaries/windows-runtime/whisper/": "whisper/",
      "binaries/windows-runtime/media/": "./",
      "binaries/windows-runtime/licenses/": "licenses/",
      "binaries/windows-runtime/runtime-manifest.json": "runtime-manifest.json"
    },
    "windows": {
      "signCommand": null,
      "webviewInstallMode": {"type": "offlineInstaller"},
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../packaging/windows/installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
